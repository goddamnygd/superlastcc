# Environment Variables of the HUB project only (the Wiki, web1-wiki). The other three sites need none.
# Read by the proxy function api/v1/[...path].js on the server; they never reach the browser.
BACKEND_URL=https://YOUR-API.vercel.app
API_KEY=                 # the same read key as the API project
# ALLOWED_ORIGINS=https://extra-site.example   (optional: more sites allowed to call the proxy)
